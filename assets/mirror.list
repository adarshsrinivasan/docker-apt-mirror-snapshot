############# config ##################
set base_path         /var/spool/apt-mirror
set mirror_path       $base_path/mirror
set skel_path         $base_path/skel
set var_path          $base_path/var
set postmirror_script $var_path/postmirror.sh
set defaultarch       amd64
# set run_postmirror    0
set nthreads          20
set limit_rate        100m
set _tilde            0
set _autoclean        1
# Use --unlink with wget (for use with hardlinked directories)
set unlink            1
############# end config ##############


############# bookworm start ###############

deb-amd64 http://deb.debian.org/debian bookworm main contrib non-free non-free-firmware
deb-arm64 http://deb.debian.org/debian bookworm main contrib non-free non-free-firmware
deb-armhf http://deb.debian.org/debian bookworm main contrib non-free non-free-firmware

deb-amd64 http://deb.debian.org/debian bookworm-updates main contrib non-free non-free-firmware
deb-arm64 http://deb.debian.org/debian bookworm-updates main contrib non-free non-free-firmware
deb-armhf http://deb.debian.org/debian bookworm-updates main contrib non-free non-free-firmware

deb-amd64 http://deb.debian.org/debian bookworm-backports main contrib non-free non-free-firmware
deb-arm64 http://deb.debian.org/debian bookworm-backports main contrib non-free non-free-firmware
deb-armhf http://deb.debian.org/debian bookworm-backports main contrib non-free non-free-firmware

deb-amd64 http://security.debian.org/debian-security bookworm-security main contrib non-free non-free-firmware
deb-arm64 http://security.debian.org/debian-security bookworm-security main contrib non-free non-free-firmware
deb-armhf http://security.debian.org/debian-security bookworm-security main contrib non-free non-free-firmware
############# bookworm start ###############

clean